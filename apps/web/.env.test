# Bun auto-loads this file when NODE_ENV=test, which `bun test` sets.
NODE_ENV=test
# Never actually bound: the suite imports library modules, not `server.ts`, so
# nothing calls Bun.serve on this port. Kept off 3000/3001 so it cannot be
# mistaken for the API or the web dev server.
PORT=3098
# Keep test output readable.
LOG_LEVEL=silent
# `api.server.ts` captures this at import time, so the stub server in
# `request-id.server.test.ts` has to listen on exactly this port.
API_URL=http://localhost:3097
