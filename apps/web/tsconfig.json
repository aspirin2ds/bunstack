{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],
    "jsx": "react-jsx",

    // shadcn/ui generates imports as `@/components/ui/button`; Vite resolves the
    // same alias through `resolve.tsconfigPaths` reading this block. No `baseUrl`:
    // TypeScript 7 removed it, and `paths` resolve relative to this file anyway.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "server.ts"]
}
