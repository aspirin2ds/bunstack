# Copy to .env and adjust. The web app talks to the API over HTTP and has no
# database access of its own — there is deliberately no DATABASE_URL here
# (RULES.md WS-05).
NODE_ENV=development
PORT=3001

# Base URL of the API. `localhost:3000` for local development; in docker compose
# this is the service name, `http://api:3000`.
API_URL=http://localhost:3000

# --- optional, shown with their defaults ---

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Deadline for a single call to the API, in milliseconds.
# API_TIMEOUT_MS=10000
