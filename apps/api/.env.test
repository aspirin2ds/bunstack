# Bun auto-loads this file when NODE_ENV=test, which `bun test` sets.
# The default test suite mocks the service layer and never opens a connection,
# so this URL only has to satisfy env validation.
NODE_ENV=test
# Never actually bound: the suites import `app.ts`, not `index.ts`, so nothing calls
# Bun.serve. Kept off 3000/3001 anyway so it cannot be mistaken for the API or web port.
PORT=3099
# Keep test output readable; the logger is exercised explicitly where it matters.
LOG_LEVEL=silent
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appdb_test
