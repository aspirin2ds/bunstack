# Copy to .env and adjust. Matches the docker-compose postgres service defaults.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appdb

# --- optional, shown with their defaults ---

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Connection pool. Keep DB_POOL_MAX * replicas under Postgres max_connections (100).
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT=30
# DB_CONNECTION_TIMEOUT=10
# DB_MAX_LIFETIME=0

# Largest accepted request body, in bytes (1 MiB).
# BODY_LIMIT_BYTES=1048576

# Request deadline (including uploads), also the PostgreSQL per-statement timeout.
# A 504 does not guarantee that a write was rolled back.
# REQUEST_TIMEOUT_MS=30000

# Comma-separated allowed origins. Unset means the CORS middleware is not
# mounted at all, which is the right default for a same-origin API.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
