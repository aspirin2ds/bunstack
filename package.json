{
  "name": "bunstack",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "latest",
      "hono": "^4.12.32",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "typescript": "^5.9.0",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "dev": "bun --filter './apps/*' dev",
    "dev:up": "bun scripts/dev.ts",
    "dev:api": "bun run --filter '@repo/api' dev",
    "dev:web": "bun run --filter '@repo/web' dev",
    "build": "bun run --filter '@repo/web' build",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun run --filter '@repo/api' --filter '@repo/api-client' --filter '@repo/web' test:unit",
    "test:integration": "bun run --filter '@repo/api' test:integration",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "format": "bunx --bun biome format --write .",
    "check": "bun run lint && bun run check:rules && bun run typecheck && bun run test",
    "update": "./scripts/fetch-docs.sh --force && bun update --recursive && bun install --frozen-lockfile && bun run check",
    "check:rules": "bun scripts/check-rules.ts",
    "db:generate": "bun run --filter '@repo/api' db:generate",
    "db:migrate": "bun run --filter '@repo/api' db:migrate",
    "init": "bun scripts/init.ts"
  },
  "bun-create": {
    "postinstall": "scripts/init.ts --from-create"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
